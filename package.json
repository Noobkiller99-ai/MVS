{
  "name": "mvs-basmati-story",
  "version": "2.0.0",
  "private": true,
  "description": "MVS Basmati - farm-to-pack story website with a scroll-driven 3D grain.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/grain-scene.js --bundle --format=esm --minify --target=es2020 --legal-comments=linked --outfile=assets/js/grain-scene.js",
    "watch": "npm run build -- --watch",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/smoke-test.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "0.185.1"
  }
}
